# Copy to .env (not committed). Vite only exposes VITE_* to the app.
VITE_API_BASE=https://api.turnaroundiq.co.uk
# RevenueCat PUBLIC SDK keys (Project -> API keys). test_ keys = Test Store only.
VITE_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxx
VITE_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx
# RevenueCat entitlement id (must match REVENUECAT_ENTITLEMENT on the server)
VITE_RC_ENTITLEMENT=pro
# Browser development only (no store purchases in a browser):
# VITE_DEV_USER_ID=<a RevenueCat sandbox appUserID>
# Show the Model Testing page (your id must be in ADMIN_USER_IDS on the server)
VITE_SHOW_DEV_TOOLS=false
# Legal pages (defaults: terms.html / privacy.html shipped in public/)
# VITE_TERMS_URL=
# VITE_PRIVACY_URL=
