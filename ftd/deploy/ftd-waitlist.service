[Unit]
Description=FTD waitlist API
After=network.target

[Service]
WorkingDirectory=/root/TurnaroundIQ/ftd
EnvironmentFile=-/etc/ftd.env
ExecStart=/usr/bin/env python3 -m uvicorn server.waitlist_api:app --host 127.0.0.1 --port 8090 --proxy-headers
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
