# Copy to /etc/turnaroundiq.env (chmod 600). Read by systemd, cron and CLI
# (via env_loader.py). Never commit the real file.

# --- Data providers -------------------------------------------------------
# api-sports.io (API-Football v3) — live results, upcoming fixtures, historical backfill
API_FOOTBALL_KEY=
# Daily calls the historical backfill must leave untouched for live + the app
APISPORTS_RESERVE=500
# Seconds between backfill calls
APISPORTS_DELAY=1.0
# Optional: TheStatsAPI xG/odds (run.py live --thestatsapi only)
THESTATSAPI_KEY=

# --- RevenueCat ------------------------------------------------------------
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT=pro

# --- Web app sign-in (email code) ------------------------------------------
# Long random string: bash deploy/set_env.sh AUTH_SECRET $(openssl rand -hex 32)
AUTH_SECRET=
# Any SMTP provider (Brevo, Resend, Gmail app password, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TurnaroundIQ <no-reply@turnaroundiq.co.uk>
# RevenueCat Web Purchase Link (Stripe checkout), e.g. https://pay.rev.cat/abc123
RC_WEB_PURCHASE_LINK=

# Free beta (billing/beta.py): every signed-in account gets Pro until this date
# (inclusive, UK time). Blank = no beta. Paying subscribers are unaffected.
BETA_FREE_UNTIL=
# Optional: only the first N accounts to sign up get the beta (blank/0 = no cap)
BETA_MAX_USERS=
# Optional: price shown to beta users for subscribing early, e.g. £6.99
BETA_FOUNDER_PRICE=

# --- API -------------------------------------------------------------------
CORS_ORIGINS=*
# Upcoming-fixtures cache (API-Football calls = UPCOMING_DAYS per refresh)
FIXTURE_CACHE_SECONDS=1800
UPCOMING_DAYS=7
# Mismatch Meter stays off until it is proven in paper tracking
FEATURE_MISMATCH=0
# RevenueCat app user ids allowed to read GET /model/runs (Model Testing page)
ADMIN_USER_IDS=

# --- Ops -------------------------------------------------------------------
# TURNAROUNDIQ_DB=/root/TurnaroundIQ/two_up.db
# BACKUP_DIR=/root/TurnaroundIQ/backups
BACKUP_KEEP=30
# Scheduled live runs only need recent days (full 75-day sweep burns quota)
RESULTS_LOOKBACK_DAYS=3
# House paper account used by the scheduled paper log
PAPER_USER=house_paper
# Optional dead-man's-switch pings (e.g. healthchecks.io), one per job:
# HEALTHCHECK_URL_LIVE=
# HEALTHCHECK_URL_BACKUP=
# HEALTHCHECK_URL_PAPER=
# HEALTHCHECK_URL_HEALTH=
