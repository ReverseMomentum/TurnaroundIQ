# FTD waitlist API settings. On the server this lives in /etc/ftd.env (chmod 600).
# Locally, copy to ftd/server/.env. Never commit real values.

# Where signups are stored (SQLite). Back this file up.
FTD_WAITLIST_DB=/var/lib/ftd/ftd_waitlist.db

# Optional: also add each signup to a Resend audience (resend.com -> Audiences).
# Leave blank to store signups locally only.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Optional: only accept browser POSTs from these origins (comma-separated).
FTD_ALLOWED_ORIGINS=https://ftd.example.com
