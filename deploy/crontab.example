# TurnaroundIQ schedule (UTC). Install:  crontab deploy/crontab.example
# Edit the path if the repo is not at /root/TurnaroundIQ.
# Every job: locked, logged to logs/<name>.log, optional healthcheck ping.
SHELL=/bin/bash
J=/root/TurnaroundIQ/scripts/cron_job.sh

# Results + team stats every 3h (last 3 days only), post-live backup on success
20 */3 * * *  $J live python -u run.py live --skip-odds
# Once a day with football-data odds as well
40 6 * * *    $J live python -u run.py live

# Pre-match odds (api-sports, in plan): best UK back + estimated lay for games in
# the next 24h, every 3h (8:40 and 14:40 land just before the paper log). Users can
# also press "Refresh odds" in the app (shared 15-min cooldown, same lock).
40 2,5,8,11,14,17,20,23 * * *  $J odds python -u collectors/odds_apisports.py --hours 24 --max-calls 200

# The Stables: UK/IRE race cards + Betfair exchange prices for the next 12h, every
# 15 min from 08:00 to 20:45 UTC. Needs BETFAIR_APP_KEY / _USERNAME / _PASSWORD.
# (Job name is not "betfair": the collector takes logs/betfair.lock itself.)
*/15 8-20 * * *  $J racecards python -u collectors/betfair.py --hours 12

# Paper log: open picks for today's slate, settle finished ones
0 9,15 * * *  $J paper python -u scripts/paper_auto_products.py --products fta,early,chaos
50 */3 * * *  $J paper-settle python -u scripts/paper_auto_products.py --settle-only

# Historical backfill from api-sports.io (last 10 completed seasons, all leagues).
# Resumes nightly; stops leaving APISPORTS_RESERVE calls for live collection.
# Exit 3 = stopped at the quota (expected until complete; no ping URL needed).
15 1 * * *    $J backfill python -u collectors/backfill_apisports.py
# Rebuild historical profiles weekly from everything collected (backs up first;
# refuses to shrink historical_matches).
40 4 * * 0    $J historical python -u run.py historical --no-fetch

# Nightly backup (live runs also back up after success)
30 3 * * *    $J backup python -u run.py backup --label nightly

# Data health — exit 1/2 = degraded/critical, pings /fail
*/30 * * * *  $J health python -u run.py health

# Retraining stays a deliberate ops step (run walk-forward, review, then train).
# To automate later: backs up first and refuses on empty training_data.
# 10 4 * * 1  $J train python -u run.py train

# Monthly scorecard: what the app said before kick-off vs what happened
# (the API logs predictions itself; this only prints the report to logs/scorecard.log).
5 9 1 * *    $J scorecard python -u scripts/scorecard.py --days 31
